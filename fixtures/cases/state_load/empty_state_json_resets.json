{
  "description": "A zero-byte state.json (e.g. a write cut short on an old updater) resets like a corrupt one and queues a client_id_regenerated event.",
  "files": {
    "storage/state.json": {
      "text": ""
    },
    "storage/pointers.json": {
      "json": {
        "next_boot_patch": 1,
        "last_booted_patch": 1,
        "currently_booting_patch": null,
        "boot_started_at": null
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 5
      }
    },
    "storage/patches/1/dlc.vmcode": {
      "text": "hello"
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "next_boot_patch_number",
      "expect": 0,
      "expect_files": {
        "storage/state.json": {
          "json": {
            "client_id": "<uuid>",
            "release_version": "1.0.0+1",
            "queued_events": [
              {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "<uuid>",
                "event_id": "<uuid>",
                "type": "__patch_update_failure__",
                "patch_number": 0,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": "client_id_regenerated: reason=corrupt_state",
                "failure_category": "client_id_regenerated"
              }
            ]
          }
        },
        "storage/patches": {
          "absent": true
        }
      }
    }
  ]
}
