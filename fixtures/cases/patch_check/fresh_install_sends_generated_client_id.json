{
  "description": "A fresh install sends the client_id it just generated.",
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "<uuid>"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": false
            }
          }
        }
      ],
      "expect": {
        "status": 0,
        "message": "No update"
      }
    }
  ]
}
