{
  "description": "After launch_start on patch 1, patch checks carry current_patch_number: 1.",
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    },
    "storage/pointers.json": {
      "json": {
        "next_boot_patch": 1,
        "last_booted_patch": 1,
        "currently_booting_patch": null,
        "boot_started_at": null
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 5
      }
    },
    "storage/patches/1/dlc.vmcode": {
      "text": "hello"
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "report_launch_start"
    },
    {
      "call": "current_boot_patch_number",
      "expect": 1
    },
    {
      "call": "report_launch_success"
    },
    {
      "call": "check_for_downloadable_update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001",
              "current_patch_number": 1
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": false
            }
          }
        }
      ],
      "expect": false
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001",
              "current_patch_number": 1
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": false
            }
          }
        }
      ],
      "expect": {
        "status": 0,
        "message": "No update"
      }
    }
  ]
}
