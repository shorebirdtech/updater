{
  "description": "patch_verification: strict. A patch 1 offer signed with another key is refused; a later offer of the same patch 1 with a valid signature still downloads, installs and boots.",
  "base": {
    "file": "bipatch/text_edit/base.bin"
  },
  "yaml": "app_id: fixture-app-id\nbase_url: {{server}}\npatch_public_key: {{public_key}}\npatch_verification: strict\n",
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin",
                "hash_signature": ""
              }
            }
          }
        }
      ],
      "expect": {
        "status": -1,
        "message": "<any>"
      },
      "expect_files": {
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Bad",
            "reason": "InvalidSignature",
            "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
            "signature": "",
            "size": null
          }
        },
        "storage/state.json": {
          "json": {
            "client_id": "00000000-0000-4000-8000-000000000001",
            "release_version": "1.0.0+1",
            "queued_events": [
              {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_update_failure__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": "<prefix:update_failure: patch 1 failed (>",
                "failure_category": "invalid_signature"
              }
            ]
          }
        }
      },
      "expect_tree": [
        "app/libapp.so",
        "storage/patches/1/state.json",
        "storage/state.json"
      ]
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_update_failure__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": "<prefix:update_failure: patch 1 failed (>",
                "failure_category": "invalid_signature"
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin",
                "hash_signature": ""
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/patches/1.bin",
            "headers": {
              "range": null
            }
          },
          "response": {
            "status": 200,
            "body": {
              "file": "bipatch/text_edit/patch.bin"
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_download__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": null
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        }
      ],
      "expect": {
        "status": 1,
        "message": "Update installed"
      },
      "expect_files": {
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Installed",
            "signature": "",
            "size": 10695
          }
        },
        "storage/patches/1/dlc.vmcode": {
          "same_as": {
            "file": "bipatch/text_edit/new.bin"
          }
        },
        "storage/pointers.json": {
          "json": {
            "next_boot_patch": 1,
            "last_booted_patch": null,
            "currently_booting_patch": null,
            "boot_started_at": null
          }
        }
      }
    },
    {
      "call": "restart"
    },
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "validate_next_boot_patch"
    },
    {
      "call": "next_boot_patch_number",
      "expect": 1
    },
    {
      "call": "report_launch_start"
    },
    {
      "call": "current_boot_patch_number",
      "expect": 1
    }
  ]
}
