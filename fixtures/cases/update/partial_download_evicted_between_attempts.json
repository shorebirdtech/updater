{
  "description": "A partial download the OS evicts before the retry is fetched again from the start, without Range.",
  "base": {
    "file": "bipatch/text_edit/base.bin"
  },
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/patches/1.bin",
            "headers": {
              "range": null
            }
          },
          "response": {
            "status": 200,
            "body": {
              "file": "bipatch/text_edit/patch.bin"
            },
            "close_after_bytes": 20
          }
        }
      ],
      "expect": {
        "status": -1,
        "message": "<any>"
      }
    },
    {
      "call": "update",
      "write_files": {
        "cache/downloads/1": {
          "delete": true
        }
      },
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_update_failure__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": "<prefix:update_failure: patch 1 failed (>",
                "failure_category": "<string>"
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/patches/1.bin",
            "headers": {
              "range": null
            }
          },
          "response": {
            "status": 200,
            "body": {
              "file": "bipatch/text_edit/patch.bin"
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_download__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": null
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        }
      ],
      "expect": {
        "status": 1,
        "message": "Update installed"
      }
    }
  ]
}
