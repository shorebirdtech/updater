{
  "description": "An update() made while another is still downloading returns UpdateInProgress (4) at once, without a request of its own; the running update finishes and installs. Patch checks still run alongside, and once it finishes the next update() takes the lock again.",
  "base": {
    "file": "bipatch/text_edit/base.bin"
  },
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "report_launch_start"
    },
    {
      "call": "report_launch_success"
    },
    {
      "call": "update",
      "background": true,
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/patches/1.bin",
            "headers": {
              "range": null
            }
          },
          "response": {
            "status": 200,
            "body": {
              "file": "bipatch/text_edit/patch.bin"
            },
            "hold": true
          }
        }
      ]
    },
    {
      "call": "update",
      "expect": {
        "status": 4,
        "message": "Update already in progress"
      }
    },
    {
      "call": "next_boot_patch_number",
      "expect": 0
    },
    {
      "call": "check_for_downloadable_update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        }
      ],
      "expect": true
    },
    {
      "call": "await",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "event_id": "<uuid>",
                "type": "__patch_download__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": null
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        }
      ],
      "expect": {
        "status": 1,
        "message": "Update installed"
      },
      "expect_files": {
        "storage/pointers.json": {
          "json": {
            "next_boot_patch": 1,
            "last_booted_patch": null,
            "currently_booting_patch": null,
            "boot_started_at": null
          }
        },
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Installed",
            "signature": null,
            "size": 10695
          }
        }
      }
    },
    {
      "call": "next_boot_patch_number",
      "expect": 1
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        }
      ],
      "expect": {
        "status": 0,
        "message": "No update"
      }
    }
  ]
}
