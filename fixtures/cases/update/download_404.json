  },
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
