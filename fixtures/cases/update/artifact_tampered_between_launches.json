{
  "description": "An installed artifact that changes size on disk between launches fails validation at the next boot and is tombstoned.",
  "base": {
    "file": "bipatch/text_edit/base.bin"
  },
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/patches/1.bin",
            "headers": {
              "range": null
            }
          },
          "response": {
            "status": 200,
            "body": {
              "file": "bipatch/text_edit/patch.bin"
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_download__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": null
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        }
      ],
      "expect": {
        "status": 1,
        "message": "Update installed"
      }
    },
    {
      "call": "restart"
    },
    {
      "call": "init",
      "expect": true,
      "write_files": {
        "storage/patches/1/dlc.vmcode": {
          "text": "truncated"
        }
      }
    },
    {
      "call": "validate_next_boot_patch"
    },
    {
      "call": "next_boot_patch_number",
      "expect": 0,
      "expect_files": {
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Bad",
            "reason": "ValidationFailed",
            "hash": null,
            "signature": null,
            "size": 10695
          }
        },
        "storage/patches/1/dlc.vmcode": {
          "absent": true
        }
      }
    }
  ]
}
