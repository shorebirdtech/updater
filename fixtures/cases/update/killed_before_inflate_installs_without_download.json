{
  "description": "Killed after the download completed but before install (state Downloaded, bytes on disk): the next update installs without downloading again.",
  "base": {
    "file": "bipatch/text_edit/base.bin"
  },
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Downloaded",
        "url": "{{server}}/patches/1.bin",
        "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
        "signature": null,
        "size": 63
      }
    },
    "cache/downloads/1": {
      "file": "bipatch/text_edit/patch.bin"
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "update",
      "http": [
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/check",
            "json": {
              "app_id": "fixture-app-id",
              "channel": "stable",
              "release_version": "1.0.0+1",
              "platform": "<platform>",
              "arch": "<arch>",
              "client_id": "00000000-0000-4000-8000-000000000001"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "patch_available": true,
              "patch": {
                "number": 1,
                "hash": "3dcb171d162d03aa5a957400955a5720d767dda94deaae87b90dafed594e7285",
                "download_url": "{{server}}/patches/1.bin"
              }
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/api/v1/patches/events",
            "json": {
              "event": {
                "app_id": "fixture-app-id",
                "arch": "<arch>",
                "client_id": "00000000-0000-4000-8000-000000000001",
                "type": "__patch_download__",
                "patch_number": 1,
                "platform": "<platform>",
                "release_version": "1.0.0+1",
                "timestamp": "<number>",
                "message": null
              }
            }
          },
          "response": {
            "status": 200,
            "text": ""
          }
        }
      ],
      "expect": {
        "status": 1,
        "message": "Update installed"
      },
      "expect_files": {
        "storage/patches/1/dlc.vmcode": {
          "same_as": {
            "file": "bipatch/text_edit/new.bin"
          }
        },
        "cache/downloads/1": {
          "absent": true
        },
        "storage/patches/1/state.json": {
          "json": {
            "kind": "Installed",
            "signature": null,
            "size": 10695
          }
        }
      }
    }
  ]
}
