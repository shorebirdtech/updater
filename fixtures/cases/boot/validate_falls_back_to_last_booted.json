{
  "description": "When the new next_boot patch fails validation, next boot falls back to last_booted_patch.",
  "files": {
    "storage/state.json": {
      "json": {
        "client_id": "00000000-0000-4000-8000-000000000001",
        "release_version": "1.0.0+1",
        "queued_events": []
      }
    },
    "storage/pointers.json": {
      "json": {
        "next_boot_patch": 2,
        "last_booted_patch": 1,
        "currently_booting_patch": null,
        "boot_started_at": null
      }
    },
    "storage/patches/1/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 5
      }
    },
    "storage/patches/1/dlc.vmcode": {
      "text": "hello"
    },
    "storage/patches/2/state.json": {
      "json": {
        "kind": "Installed",
        "signature": null,
        "size": 99
      }
    },
    "storage/patches/2/dlc.vmcode": {
      "text": "hello"
    }
  },
  "steps": [
    {
      "call": "init",
      "expect": true
    },
    {
      "call": "validate_next_boot_patch"
    },
    {
      "call": "next_boot_patch_number",
      "expect": 1,
      "expect_files": {
        "storage/patches/2/state.json": {
          "json": {
            "kind": "Bad",
            "reason": "ValidationFailed",
            "hash": null,
            "signature": null,
            "size": 99
          }
        },
        "storage/pointers.json": {
          "json": {
            "next_boot_patch": 1,
            "last_booted_patch": 1,
            "currently_booting_patch": null,
            "boot_started_at": null
          }
        }
      }
    }
  ]
}
